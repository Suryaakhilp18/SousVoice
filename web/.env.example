# SousVoice web client — environment configuration
# Copy this file to .env.local and fill in as needed.

# Set to "true" to boot straight into the offline mock simulation
# (no LiveKit server, Deepgram/OpenAI/Rime keys, or backend required).
VITE_MOCK_MODE=false

# Base URL of scripts/token_server.py (the LiveKit token minting endpoint).
# Only used when VITE_MOCK_MODE is false.
VITE_TOKEN_SERVER_URL=http://localhost:8000

# Rime TTS attribution shown in the live session footer — should match
# the values used by agent/main.py on the backend.
VITE_RIME_MODEL=mistv2
VITE_RIME_SPEAKER=abbie
VITE_RIME_LANG=eng
