# Copy this file to .env and fill in real values. Never commit .env.

# --- LiveKit (realtime transport) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme

# --- Rime (text-to-speech, primary spoken output) ---
RIME_API_KEY=changeme
# Model/voice/language actually used in the judged demo. Keep these in sync
# with RIME_EVIDENCE.md and README.md if you change them.
RIME_MODEL=mistv2
RIME_SPEAKER=abbie
RIME_LANG=eng

# --- LLM ---
OPENAI_API_KEY=changeme

# --- Speech-to-text ---
DEEPGRAM_API_KEY=changeme

# --- Demo/stress-test knob ---
# Fixed artificial delay (seconds) injected into the substitution lookup
# tool, so the interruption stress case is reproducible on demand. Also
# used directly by the offline test suite via an explicit argument.
LOOKUP_DELAY_SECONDS=2.5
